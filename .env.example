# Copia este archivo como .env y completa tus valores. NUNCA subas .env a GitHub.

# Clave de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo de Gemini. El curso usa gemini-2.5-flash, pero Google lo retira el 01/12/2026.
GEMINI_MODEL=gemini-3.6-flash

# Pipedrive: Configuración personal > API (token) y el subdominio de tu cuenta
# Si tu cuenta es https://miempresa.pipedrive.com, el dominio es: miempresa
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_DOMAIN=

# Usuario y clave que tú inventas para proteger el webhook (Basic Auth)
WEBHOOK_USER=
WEBHOOK_PASSWORD=
